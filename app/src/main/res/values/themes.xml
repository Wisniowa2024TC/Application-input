<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Motyw aplikacji. Celowo zawsze jasny (Light) – projekt graficzny INPUT jest jasny,
        a w trybie ciemnym jasne karty i ciemne napisy wyglądałyby źle.
    -->
    <style name="Base.Theme.DemoEmptyActivity" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_light</item>
        <item name="colorOnPrimaryContainer">@color/navy_dark</item>
        <item name="colorSecondaryContainer">@color/blue_light</item>
        <item name="colorOnSecondaryContainer">@color/navy_dark</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.DemoEmptyActivity" parent="Base.Theme.DemoEmptyActivity" />

    <!-- ===== Style tekstów – żeby wszystkie ekrany wyglądały spójnie ===== -->

    <!-- Duży nagłówek ekranu, np. "Cześć, Jakub!" -->
    <style name="Text.Title" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/navy_dark</item>
    </style>

    <!-- Podtytuł pod nagłówkiem -->
    <style name="Text.Subtitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/navy_dark</item>
    </style>

    <!-- Nagłówek sekcji, np. "Polecane" -->
    <style name="Text.Section" parent="">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/navy_dark</item>
    </style>

    <!-- Zwykły szary tekst pomocniczy -->
    <style name="Text.Secondary" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ===== Style elementów ===== -->

    <!-- Główny przycisk: granatowy, zaokrąglony (np. "Zaloguj się") -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/navy</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Przycisk drugorzędny: biały z granatową ramką (np. "Zarejestruj się") -->
    <style name="Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/navy</item>
        <item name="android:textColor">@color/navy_dark</item>
        <item name="android:textSize">17sp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Biała karta z zaokrąglonymi rogami i cienką ramką -->
    <style name="Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Pole tekstowe z ramką -->
    <style name="InputField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/navy</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="startIconTint">@color/navy</item>
    </style>

    <!-- Przyciski wyboru roli Klient / Kurier -->
    <style name="Button.Role" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/card_stroke</item>
        <item name="android:textColor">@color/navy_dark</item>
        <item name="iconTint">@color/navy</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
