<?xml version="1.0" encoding="utf-8"?>
<!--
    Ekran powitalny: logo, maskotka, przyciski "Zaloguj się" i "Zarejestruj się".
    Na dole adres serwera – można go zmienić (np. gdy testujemy na prawdziwym telefonie).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    tools:context=".MainActivity">

    <!-- Logo: ikona paczkomatu + napis INPUT -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Logo INPUT"
            android:src="@drawable/fav2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INPUT"
            android:textColor="@color/navy_dark"
            android:textSize="52sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zamów. Odbierz. Gotowe!"
        android:textColor="@color/navy_dark"
        android:textSize="20sp" />

    <!-- Maskotka zajmuje całe wolne miejsce między logo a przyciskami -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:contentDescription="Maskotka INPUT"
        android:scaleType="fitCenter"
        android:src="@drawable/felis" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="Zaloguj się"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="end"
        app:iconTint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_register"
        style="@style/Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="Zarejestruj się" />

    <!-- "Dowiedz się więcej" – krótki opis, jak działa INPUT -->
    <TextView
        android:id="@+id/tv_learn_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:drawableEnd="@drawable/ic_expand_more"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:text="Dowiedz się więcej"
        android:textColor="@color/navy_dark"
        android:textSize="16sp" />

    <!-- Adres serwera (kliknięcie = zmiana adresu) -->
    <TextView
        android:id="@+id/tv_server"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="6dp"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        tools:text="Serwer: http://10.0.2.2:8080 (zmień)" />

</LinearLayout>
