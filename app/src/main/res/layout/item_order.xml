<?xml version="1.0" encoding="utf-8"?>
<!--
    Jedna karta zamówienia na liście (klient i kurier).
    Wypełniana w kodzie przez OrderViews.createOrderCard().
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Emoji restauracji w kółku, np. 🍔 -->
        <TextView
            android:id="@+id/tv_emoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle"
            android:gravity="center"
            android:textSize="24sp"
            tools:text="🍔" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/navy_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="#1047" />

            <TextView
                android:id="@+id/tv_line1"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Dostawa do: Paczkomat A1" />

            <TextView
                android:id="@+id/tv_line2"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="2× Burger Classic, 1× Frytki" />

            <!-- Kod odbioru – widoczny tylko, gdy jedzenie czeka w paczkomacie -->
            <TextView
                android:id="@+id/tv_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/pink"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Kod odbioru: 123456 • Paczkomat A1"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/navy_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="12:30" />

            <!-- Kolorowa plakietka ze statusem (kolor ustawia OrderViews.styleStatusBadge) -->
            <TextView
                android:id="@+id/tv_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="W drodze" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
