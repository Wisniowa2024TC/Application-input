<?xml version="1.0" encoding="utf-8"?>
<!--
    Zakładka wspólna dla klienta ("Paczkomat") i kuriera ("Mapa").
    Klient widzi instrukcję odbioru z maskotką i listę paczkomatów.
    Kurier widzi restauracje (tu odbiera jedzenie) i paczkomaty (tu je zostawia).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tv_title"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Paczkomaty" />

        <TextView
            android:id="@+id/tv_subtitle"
            style="@style/Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Tu odbierzesz swoje jedzenie" />

        <!-- Tylko dla klienta: maskotka tłumaczy, jak odebrać jedzenie -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/how_to"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/blue_light"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/maskotka_pomoc" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jak odebrać jedzenie?"
                        android:textColor="@color/navy_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="1. Gdy kurier włoży jedzenie do skrytki, dostaniesz kod.\n2. Wpisz kod na klawiaturze albo otwórz skrytkę w aplikacji.\n3. Wyjmij jedzenie i zamknij drzwiczki."
                        android:textColor="@color/navy_dark"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Maskotka: ładowanie / błąd -->
        <include layout="@layout/view_mascot_state" />

        <!-- Tylko dla kuriera: restauracje -->
        <TextView
            android:id="@+id/tv_restaurants_title"
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Restauracje – tu odbierasz jedzenie"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/restaurants_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_lockers_title"
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="Paczkomaty – tu zostawiasz jedzenie"
            android:visibility="gone" />

        <!-- Karty paczkomatów są dodawane tutaj w kodzie (item_locker.xml) -->
        <LinearLayout
            android:id="@+id/lockers_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
