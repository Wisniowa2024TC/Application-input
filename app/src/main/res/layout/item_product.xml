<?xml version="1.0" encoding="utf-8"?>
<!-- Jedno danie w menu: emoji, nazwa, opis, cena i przycisk "+" (dodaj do koszyka). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_emoji"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle"
            android:gravity="center"
            android:textSize="28sp"
            tools:text="🍕" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/navy_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Pizza Margherita" />

            <TextView
                android:id="@+id/tv_description"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Sos pomidorowy, mozzarella, świeża bazylia" />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/navy_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="29,99 zł" />
        </LinearLayout>

        <!-- Przycisk "+" – granatowe kółko -->
        <TextView
            android:id="@+id/btn_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/navy"
            android:contentDescription="Dodaj do koszyka"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
